{
  "schemaVersion": 1,
  "id": "hbm",
  "version": "${version}",
  "name": "NTM NEXT",
  "description": "Nuclear Tech Mod, ported to Minecraft ${minecraft_version} for Fabric and NeoForge. Copyright HbmMods (The Bobcat), Contributors to Hbm's Nuclear Tech Mod, 2026 movblock <admin@movblock.mov>; the GNU GPL and LGPL texts are LICENSES/GPL-3.0-only.txt and LICENSES/LGPL-3.0-only.txt in this jar.",
  "authors": [
    "HbmMods (The Bobcat) - creating the original mod",
    "movblock - porting to 26.2"
  ],
  "contributors": [
    "MrNorwood - raw ore textures: thorium, cobalt, lithium, schrabidium",
    "Mr. Morgan - raw ore textures: aluminium, beryllium, lead, plutonium, titanium, tungsten, uranium",
    "NuclearGrandFather - raw ore textures: aluminium, beryllium, lead, plutonium, titanium, tungsten, uranium"
  ],
  "license": "LGPL-3.0-only",
  "icon": "hbm.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.hbm.fabric.NuclearTechFabric"
    ],
    "client": [
      "com.hbm.fabric.client.NuclearTechFabricClient"
    ],
    "jei_mod_plugin": [
      "com.hbm.integration.jei.NTMJeiPlugin"
    ],
    "rei_client": [
      "com.hbm.integration.rei.NTMReiClientPlugin",
      "com.hbm.integration.rei.NTMReiCommonPlugin"
    ],
    "jade": [
      "com.hbm.integration.jade.NTMJadePlugin"
    ]
  },
  "mixins": [
    "hbm-common.mixins.json",
    "hbm-iris-compat.mixins.json",
    "hbm-jigsaw-optimizer.mixins.json",
    "hbm-network-optimizer.mixins.json",
    "hbm-replay-timing.mixins.json",
    "hbm-fabric.mixins.json"
  ],
  "accessWidener": "hbm.classtweaker",
  "jars": [
    {
      "file": "META-INF/jars/hbm-client-dependency.jar"
    }
  ],
  "depends": {
    "hbm_client": "*",
    "fabricloader": ">=${fabric_loader_minimum}",
    "mixinextras": ">=0.5.5",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}"
  },
  "suggests": {
    "team_reborn_energy": ">=5.0.0"
  },
  "breaks": {
    "ae2": "*",
    "fusion": "<1.3.13",
    "iris": "<${iris_minimum}",
    "sodium": "<${sodium_minimum}",
    "scalablelux": "<0.3.0-alpha.0.3",
    "lithium": [
      "<${lithium_minimum}",
      ">=${lithium_maximum}"
    ]
  },
  "contact": {
    "sources": "https://github.com/Warfactory-Official/ntm-next"
  }
}
